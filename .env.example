# Project Neo local/static-host environment.
# Copy to .env.local for local work. Never commit real .env files.

# Environment label used by the build script: development, staging, production.
PROJECT_NEO_ENV=development

# Public browser config generated into dist/project-neo-config.js at build time.
PROJECT_NEO_APP_URL=http://localhost:4173
PROJECT_NEO_API_BASE_URL=http://127.0.0.1:54321/functions/v1/project-neo-api
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY
PROJECT_NEO_ADMIN_EMAIL=admin@example.com

# Optional: make non-production builds fail when public browser config is missing.
PROJECT_NEO_REQUIRE_PUBLIC_CONFIG=false

# Server-only values do not belong in the static hosting environment unless the
# host is running private server code. Keep them in Supabase Edge Function secrets.
# SUPABASE_SERVICE_ROLE_KEY=never_put_this_in_frontend_config
# PAYMENT_SECRET_KEY=server_side_only
# PAYMENT_WEBHOOK_SECRET=server_side_only
# CALENDAR_API_KEY=server_side_only
