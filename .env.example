# Project Neo local/static-host environment.
# Copy to .env.local for local work. Never commit real .env files.
# Placeholder-only file. Do not add real secrets, tokens, API keys, or passwords.

# Environment label used by the build script: development, staging, production.
APP_ENV=development
PROJECT_NEO_ENV=development
NEXT_PUBLIC_APP_ENV=development

# Public browser config generated into dist/project-neo-config.js at build time.
# Add PROJECT_NEO_APP_URL plus /auth-callback.html and /auth-reset-password.html
# to the Supabase Auth Site URL and Redirect URLs for OAuth and password resets.
PROJECT_NEO_APP_URL=http://localhost:4173
NEXT_PUBLIC_SITE_URL=http://localhost:4173
PROJECT_NEO_API_BASE_URL=http://127.0.0.1:54321/functions/v1/project-neo-api
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY
NEXT_PUBLIC_AUTH_CALLBACK_URL=http://localhost:4173/auth-callback.html
PROJECT_NEO_ADMIN_EMAIL=admin@example.com
PROJECT_NEO_PUBLIC_CONTACT_EMAIL=djtookold@gmail.com

# Optional: make non-production builds fail when public browser config is missing.
PROJECT_NEO_REQUIRE_PUBLIC_CONFIG=false

# Optional local Supabase Auth provider values for supabase/config.toml only.
# Do not add these to browser config or static hosting unless a future server
# runtime explicitly needs them. Hosted staging/production projects should set
# OAuth provider values in the Supabase Auth dashboard.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_SECRET=
SUPABASE_AUTH_EXTERNAL_APPLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_APPLE_SECRET=
SUPABASE_AUTH_EXTERNAL_APPLE_REDIRECT_URI=http://127.0.0.1:54321/auth/v1/callback

# Server-only values do not belong in the static hosting environment unless the
# host is running private server code. Keep them in Supabase Edge Function secrets.
# SUPABASE_SERVICE_ROLE_KEY=never_put_this_in_frontend_config
# SUPABASE_SECRET_KEY=server_side_only
# SUPABASE_ACCESS_TOKEN=server_side_only_for_management_api_automation
# PAYMENT_SECRET_KEY=server_side_only
# PAYMENT_WEBHOOK_SECRET=server_side_only
# CALENDAR_API_KEY=server_side_only

# Deferred Square placeholders only. Square is not implemented for the current launch gate.
# Keep Square access tokens and webhook signature keys server-side only if Square is later approved.
# SQUARE_ENVIRONMENT=sandbox
# SQUARE_APPLICATION_ID=YOUR_SQUARE_APPLICATION_ID
# SQUARE_ACCESS_TOKEN=server_side_only
# SQUARE_LOCATION_ID=YOUR_SQUARE_LOCATION_ID
# SQUARE_WEBHOOK_SIGNATURE_KEY=server_side_only
