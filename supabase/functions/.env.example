# Project Neo Supabase Edge Function secrets.
# Copy to supabase/functions/.env for local function serving.
# Never commit real secret values.

SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVER_ONLY_SERVICE_ROLE_KEY
PROJECT_NEO_ALLOWED_ORIGIN=http://localhost:4173

# Optional server-only integrations.
PROJECT_NEO_ADMIN_EMAIL=admin@example.com
PAYMENT_PROVIDER=manual
PAYMENT_SECRET_KEY=
PAYMENT_WEBHOOK_SECRET=
CALENDAR_PROVIDER=manual
CALENDAR_API_KEY=
GOOGLE_CALENDAR_ID=
